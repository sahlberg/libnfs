#include <nfsc/libnfs.h>

#if defined(WIN32) && defined(libnfs_EXPORTS)
#define EXTERN __declspec( dllexport )
#else
#ifndef EXTERN
#define EXTERN
#endif
#endif

/*
 * NFSv4 ACL
 */
/*
 * Async nfs4 get acl
 * Function returns
 *  0 : The command was queued successfully. The callback will be invoked once
 *      the command completes.
 * <0 : An error occured when trying to queue the command.
 *      The callback will not be invoked.
 *
 * When the callback is invoked, status indicates the result:
 *      0 : Success.
 *          data is fattr4_acl *
 * -errno : An error occured.
 *          data is the error string.
 */
EXTERN int nfs4_getacl_async(struct nfs_context *nfs, struct nfsfh *nfsfh,
                             nfs_cb cb, void *private_data);

/*
 * Sync nfs4 get acl
 * Function returns
 *      0 : The operation was successful.
 * -errno : The command failed.
 *
 * If the command was successful, the returned data in nfs4acl must be freed
 * by calling nfs4_acl_free()
 */
EXTERN int nfs4_getacl(struct nfs_context *nfs, struct nfsfh *nfsfh,
                       fattr4_acl *nfs4acl);

EXTERN void nfs4_acl_free(fattr4_acl *nfs4acl);

/*
 * NFSv4 named attributes.
 *
 * Every file and directory can carry a hidden directory of named attributes,
 * which are themselves ordinary files. Windows NFS clients use these to hold
 * alternate data streams.
 *
 * This is plain NFSv4, so it works for every minor version. A server that
 * does not implement named attributes answers NFS4ERR_NOTSUPP.
 */

/*
 * Async list the named attributes of a file or directory.
 *
 * Function returns
 *  0 : The command was queued successfully. The callback will be invoked once
 *      the command completes.
 * <0 : An error occured when trying to queue the command.
 *      The callback will not be invoked.
 *
 * When the callback is invoked, status indicates the result:
 *      0 : Success.
 *          data is struct nfsdir *, read with nfs_readdir() and released with
 *          nfs_closedir() exactly as for an ordinary directory.
 * -errno : An error occured.
 *          data is the error string.
 */
EXTERN int nfs4_opendir_namedattr_async(struct nfs_context *nfs,
                                        const char *path,
                                        nfs_cb cb, void *private_data);

/*
 * Sync list the named attributes of a file or directory.
 *
 * Function returns
 *      0 : The operation was successful.
 * -errno : The command failed.
 */
EXTERN int nfs4_opendir_namedattr(struct nfs_context *nfs, const char *path,
                                  struct nfsdir **nfsdir);

/*
 * Async open one named attribute of a file or directory.
 *
 * path names the file that owns the attributes and attrname is the attribute
 * itself, which may not contain '/'. flags are the same as for nfs_open2().
 * O_CREAT also creates the attribute directory if the file does not have one.
 *
 * The handle it returns is an ordinary one: read it with nfs_read(), write it
 * with nfs_write() and release it with nfs_close().
 *
 * Function returns
 *  0 : The command was queued successfully. The callback will be invoked once
 *      the command completes.
 * <0 : An error occured when trying to queue the command.
 *      The callback will not be invoked.
 *
 * When the callback is invoked, status indicates the result:
 *      0 : Success.
 *          data is struct nfsfh *
 * -errno : An error occured.
 *          data is the error string.
 */
EXTERN int nfs4_open_namedattr_async(struct nfs_context *nfs,
                                     const char *path, const char *attrname,
                                     int flags, nfs_cb cb,
                                     void *private_data);

/*
 * Sync open one named attribute of a file or directory.
 *
 * Function returns
 *      0 : The operation was successful.
 * -errno : The command failed.
 */
EXTERN int nfs4_open_namedattr(struct nfs_context *nfs, const char *path,
                               const char *attrname, int flags,
                               struct nfsfh **nfsfh);

/*
 * Async remove one named attribute of a file or directory.
 *
 * Function returns
 *  0 : The command was queued successfully. The callback will be invoked once
 *      the command completes.
 * <0 : An error occured when trying to queue the command.
 *      The callback will not be invoked.
 *
 * When the callback is invoked, status indicates the result:
 *      0 : Success.
 * -errno : An error occured.
 *          data is the error string.
 */
EXTERN int nfs4_remove_namedattr_async(struct nfs_context *nfs,
                                       const char *path,
                                       const char *attrname, nfs_cb cb,
                                       void *private_data);

/*
 * Sync remove one named attribute of a file or directory.
 *
 * Function returns
 *      0 : The operation was successful.
 * -errno : The command failed.
 */
EXTERN int nfs4_remove_namedattr(struct nfs_context *nfs, const char *path,
                                 const char *attrname);

/*
 * NFSv4.2 READ_PLUS and WRITE_SAME.
 *
 * These have no POSIX equivalent to hide behind, so they are exposed as they
 * are and an application calls them directly. Both need the context to be
 * NFSv4.2 and fail with -ENOTSUP otherwise.
 */

/*
 * Async READ_PLUS
 *
 * Like READ, but the reply describes the range as a list of extents that are
 * each either data or a hole, so a sparse file can be read without the holes
 * being sent as zeroes. Note that a hole in the reply may be longer than the
 * count that was asked for.
 *
 * Function returns
 *  0 : The command was queued successfully. The callback will be invoked once
 *      the command completes.
 * <0 : An error occured when trying to queue the command.
 *      The callback will not be invoked.
 *
 * When the callback is invoked, status indicates the result:
 *      0 : Success.
 *          data is READ_PLUS4resok *. It points into the reply and is only
 *          valid until the callback returns.
 * -errno : An error occured.
 *          data is the error string.
 */
EXTERN int nfs42_read_plus_async(struct nfs_context *nfs, struct nfsfh *nfsfh,
                                 uint64_t offset, uint32_t count,
                                 nfs_cb cb, void *private_data);

/*
 * Sync READ_PLUS
 *
 * Function returns
 *      0 : The operation was successful.
 * -errno : The command failed.
 *
 * If the command was successful, the returned data in res must be freed by
 * calling nfs42_read_plus_free().
 */
EXTERN int nfs42_read_plus(struct nfs_context *nfs, struct nfsfh *nfsfh,
                           uint64_t offset, uint32_t count,
                           READ_PLUS4resok *res);

EXTERN void nfs42_read_plus_free(READ_PLUS4resok *res);

/*
 * Async WRITE_SAME
 *
 * Writes a pattern repeatedly, so that a large run of identical blocks costs
 * one RPC rather than one per block. The application data block describes the
 * pattern, how large a block is and how many of them to write. stable is
 * non-zero to ask the server to commit the write to stable storage.
 *
 * Function returns
 *  0 : The command was queued successfully. The callback will be invoked once
 *      the command completes.
 * <0 : An error occured when trying to queue the command.
 *      The callback will not be invoked.
 *
 * When the callback is invoked, status indicates the result:
 *      0 : Success.
 *          data is write_response4 *. It points into the reply and is only
 *          valid until the callback returns.
 * -errno : An error occured.
 *          data is the error string.
 */
EXTERN int nfs42_write_same_async(struct nfs_context *nfs, struct nfsfh *nfsfh,
                                  app_data_block4 *adb, int stable,
                                  nfs_cb cb, void *private_data);

/*
 * Sync WRITE_SAME
 *
 * Function returns
 *      0 : The operation was successful and count is set to the number of
 *          bytes written.
 * -errno : The command failed.
 */
EXTERN int nfs42_write_same(struct nfs_context *nfs, struct nfsfh *nfsfh,
                            app_data_block4 *adb, int stable, uint64_t *count);

/*
 * NFSv4.2 server side copy: COPY, COPY_NOTIFY, OFFLOAD_STATUS and
 * OFFLOAD_CANCEL.
 *
 * These need the context to be NFSv4.2 and fail with -ENOTSUP otherwise.
 * The async forms hand the callback a pointer into the reply, which is only
 * valid until the callback returns. The sync forms copy the result out, and
 * it must be released with the matching _free() function.
 *
 * A server may run a COPY in the background. It then returns the stateid of
 * the copy in cr_response.wr_callback_id, and reports completion with
 * CB_OFFLOAD to the back channel handler (rpc_nfs4_enable_backchannel() in
 * libnfs-raw.h). CB_OFFLOAD may arrive before the COPY reply. Instead of, or
 * as well as, waiting for it, the client can poll the copy with
 * OFFLOAD_STATUS and stop it with OFFLOAD_CANCEL.
 */

/*
 * Async COPY
 *
 * Copies count bytes from src_offset in src to dst_offset in dst. A count of
 * 0 copies to the end of src. Set synchronous to ask the server to finish the
 * copy before it replies; it may still choose to run it in the background,
 * or fail with NFS4ERR_OFFLOAD_NO_REQS.
 *
 * Like WRITE, a synchronous copy may be short: cr_response.wr_count says how
 * much was copied, and the rest needs another COPY. If wr_committed is not
 * FILE_SYNC4 the data needs a COMMIT, e.g. nfs_fsync(), to be stable.
 *
 * For a copy within one server, notify is NULL and src and dst are both
 * open on nfs. For a copy between two servers, src is open on the source
 * server, nfs is the context for the destination server, and notify is the
 * result of nfs42_copy_notify() sent to the source server for src.
 *
 * Function returns
 *  0 : The command was queued successfully. The callback will be invoked once
 *      the command completes.
 * <0 : An error occured when trying to queue the command.
 *      The callback will not be invoked.
 *
 * When the callback is invoked, status indicates the result:
 *      0 : Success.
 *          data is COPY4resok *.
 * -errno : An error occured.
 *          data is the error string.
 */
EXTERN int nfs42_copy_async(struct nfs_context *nfs,
                            struct nfsfh *src, uint64_t src_offset,
                            struct nfsfh *dst, uint64_t dst_offset,
                            uint64_t count, int synchronous,
                            COPY_NOTIFY4resok *notify,
                            nfs_cb cb, void *private_data);

/*
 * Sync COPY
 *
 * Function returns
 *      0 : The operation was successful.
 * -errno : The command failed.
 *
 * If the command was successful, the returned data in res must be freed by
 * calling nfs42_copy_free().
 */
EXTERN int nfs42_copy(struct nfs_context *nfs,
                      struct nfsfh *src, uint64_t src_offset,
                      struct nfsfh *dst, uint64_t dst_offset,
                      uint64_t count, int synchronous,
                      COPY_NOTIFY4resok *notify, COPY4resok *res);

EXTERN void nfs42_copy_free(COPY4resok *res);

/*
 * Async COPY_NOTIFY
 *
 * Sent to the source server of a copy between two servers, to allow the
 * destination server to read src. destination says where the destination
 * server is.
 *
 * Function returns
 *  0 : The command was queued successfully. The callback will be invoked once
 *      the command completes.
 * <0 : An error occured when trying to queue the command.
 *      The callback will not be invoked.
 *
 * When the callback is invoked, status indicates the result:
 *      0 : Success.
 *          data is COPY_NOTIFY4resok *.
 * -errno : An error occured.
 *          data is the error string.
 */
EXTERN int nfs42_copy_notify_async(struct nfs_context *nfs, struct nfsfh *src,
                                   netloc4 *destination,
                                   nfs_cb cb, void *private_data);

/*
 * Sync COPY_NOTIFY
 *
 * Function returns
 *      0 : The operation was successful.
 * -errno : The command failed.
 *
 * If the command was successful, the returned data in res must be freed by
 * calling nfs42_copy_notify_free().
 */
EXTERN int nfs42_copy_notify(struct nfs_context *nfs, struct nfsfh *src,
                             netloc4 *destination, COPY_NOTIFY4resok *res);

EXTERN void nfs42_copy_notify_free(COPY_NOTIFY4resok *res);

/*
 * Async OFFLOAD_STATUS
 *
 * Asks how far the background copy identified by stateid has come. fh is
 * the destination file of the copy.
 *
 * Function returns
 *  0 : The command was queued successfully. The callback will be invoked once
 *      the command completes.
 * <0 : An error occured when trying to queue the command.
 *      The callback will not be invoked.
 *
 * When the callback is invoked, status indicates the result:
 *      0 : Success.
 *          data is OFFLOAD_STATUS4resok *. osr_complete holds the final
 *          status once the copy has finished.
 * -errno : An error occured.
 *          data is the error string.
 */
EXTERN int nfs42_offload_status_async(struct nfs_context *nfs,
                                      struct nfsfh *fh,
                                      const stateid4 *stateid,
                                      nfs_cb cb, void *private_data);

/*
 * Sync OFFLOAD_STATUS
 *
 * Function returns
 *      0 : The operation was successful.
 * -errno : The command failed.
 *
 * If the command was successful, the returned data in res must be freed by
 * calling nfs42_offload_status_free().
 */
EXTERN int nfs42_offload_status(struct nfs_context *nfs, struct nfsfh *fh,
                                const stateid4 *stateid,
                                OFFLOAD_STATUS4resok *res);

EXTERN void nfs42_offload_status_free(OFFLOAD_STATUS4resok *res);

/*
 * Async OFFLOAD_CANCEL
 *
 * Stops the background copy identified by stateid, with fh the destination
 * file. Sent to the source server with the stateid from COPY_NOTIFY, it
 * withdraws the permission that COPY_NOTIFY gave.
 *
 * Function returns
 *  0 : The command was queued successfully. The callback will be invoked once
 *      the command completes.
 * <0 : An error occured when trying to queue the command.
 *      The callback will not be invoked.
 *
 * When the callback is invoked, status indicates the result:
 *      0 : Success.
 * -errno : An error occured.
 *          data is the error string.
 */
EXTERN int nfs42_offload_cancel_async(struct nfs_context *nfs,
                                      struct nfsfh *fh,
                                      const stateid4 *stateid,
                                      nfs_cb cb, void *private_data);

/*
 * Sync OFFLOAD_CANCEL
 *
 * Function returns
 *      0 : The operation was successful.
 * -errno : The command failed.
 */
EXTERN int nfs42_offload_cancel(struct nfs_context *nfs, struct nfsfh *fh,
                                const stateid4 *stateid);
