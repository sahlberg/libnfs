# Dictionary for libnfs_nfs*_client_ops_fuzzer. XDR is big-endian, 32 bits
# per word.

# Common words: 0, 1, 2, 4, 5, 8, 16, 64, and values around the sign and
# wrap-around limits.
"\x00\x00\x00\x00"
"\x00\x00\x00\x01"
"\x00\x00\x00\x02"
"\x00\x00\x00\x04"
"\x00\x00\x00\x05"
"\x00\x00\x00\x08"
"\x00\x00\x00\x10"
"\x00\x00\x00\x40"
"\x7f\xff\xff\xff"
"\x80\x00\x00\x00"
"\xff\xff\xff\xfc"
"\xff\xff\xff\xff"

# Reply entry headers of the fuzzer's input layout (16 bits, little-endian):
# empty reply, 4 byte reply without the RPC "accepted" header, 48 byte
# unsolicited record.
"\x00\x00"
"\x04\x80"
"\x30\xc0"

# NFSv3 status: NFS3ERR_ACCES, NFS3ERR_STALE. NFS3ERR_JUKEBOX has the same
# value as NFS4ERR_DELAY below.
"\x00\x00\x00\x0d"
"\x00\x00\x00\x46"

# NFSv4 operation number followed by NFS4_OK, the start of one result in a
# COMPOUND reply: ACCESS, GETATTR, GETFH, LOOKUP, OPEN, OPEN_CONFIRM, PUTFH,
# PUTROOTFH, READ, READDIR, READLINK, RENAME, SETATTR, WRITE, EXCHANGE_ID,
# CREATE_SESSION, SEQUENCE, RECLAIM_COMPLETE, SEEK.
"\x00\x00\x00\x03\x00\x00\x00\x00"
"\x00\x00\x00\x09\x00\x00\x00\x00"
"\x00\x00\x00\x0a\x00\x00\x00\x00"
"\x00\x00\x00\x0f\x00\x00\x00\x00"
"\x00\x00\x00\x12\x00\x00\x00\x00"
"\x00\x00\x00\x14\x00\x00\x00\x00"
"\x00\x00\x00\x16\x00\x00\x00\x00"
"\x00\x00\x00\x18\x00\x00\x00\x00"
"\x00\x00\x00\x19\x00\x00\x00\x00"
"\x00\x00\x00\x1a\x00\x00\x00\x00"
"\x00\x00\x00\x1b\x00\x00\x00\x00"
"\x00\x00\x00\x1d\x00\x00\x00\x00"
"\x00\x00\x00\x22\x00\x00\x00\x00"
"\x00\x00\x00\x26\x00\x00\x00\x00"
"\x00\x00\x00\x2a\x00\x00\x00\x00"
"\x00\x00\x00\x2b\x00\x00\x00\x00"
"\x00\x00\x00\x35\x00\x00\x00\x00"
"\x00\x00\x00\x3a\x00\x00\x00\x00"
"\x00\x00\x00\x45\x00\x00\x00\x00"

# NFSv4 operation numbers alone: CREATE, LINK, LOCK, LOCKU, REMOVE,
# RESTOREFH, SAVEFH, ALLOCATE. LOCKT is 13, the NFS3ERR_ACCES word above.
"\x00\x00\x00\x06"
"\x00\x00\x00\x0b"
"\x00\x00\x00\x0c"
"\x00\x00\x00\x0e"
"\x00\x00\x00\x1c"
"\x00\x00\x00\x1f"
"\x00\x00\x00\x20"
"\x00\x00\x00\x3b"

# NFSv4 status: DELAY, DENIED, EXPIRED, GRACE, WRONGSEC, MOVED,
# STALE_CLIENTID, BAD_SEQID, SYMLINK, BADSESSION, SEQ_MISORDERED.
"\x00\x00\x27\x18"
"\x00\x00\x27\x1a"
"\x00\x00\x27\x1b"
"\x00\x00\x27\x1d"
"\x00\x00\x27\x20"
"\x00\x00\x27\x23"
"\x00\x00\x27\x26"
"\x00\x00\x27\x2a"
"\x00\x00\x27\x2d"
"\x00\x00\x27\x44"
"\x00\x00\x27\x4f"

# File handles, session id and names used by the seeds.
"fuzzfh00"
"fuzzfh04"
"fuzzsession00000"
"1000"
"users@example"
"../"
"/"
